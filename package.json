{
    "name": "filelistupextension",
    "displayName": "FileListUpExtension",
    "description": "List up file names and file paths.",
    "version": "0.1.3",
    "publisher": "yuna611d",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.listUpFileNameAndPath",
                "title": "List up file name and file path"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src",
        "pretest": "npm run compile && npm run lint",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.17.6",
        "@types/vscode": "^1.90.0",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.4.1",
        "eslint": "^9.15.0",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.15.0"
    },
    "overrides": {
        "serialize-javascript": "^7.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/yuna611d/FileListUpExtension.git"
    }
}
