{
    "name": "filelistupextension",
    "displayName": "FileListUpExtension",
    "description": "List up file names and file paths.",
    "version": "0.2.0",
    "publisher": "yuna611d",
    "license": "MIT",
    "keywords": [
        "file",
        "list",
        "csv",
        "path",
        "directory"
    ],
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:extension.listUpFileNameAndPath"
    ],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "fileListUp.listUpFileNameAndPath",
                "category": "File List Up",
                "title": "List up file name and file path"
            }
        ],
        "configuration": {
            "title": "FileListUpExtension",
            "properties": {
                "fileListUp.excludeDirectories": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "node_modules",
                        ".git",
                        ".svn",
                        ".hg"
                    ],
                    "markdownDescription": "Directory names that are never descended into. Matched exactly against the directory name, not as a glob."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src",
        "pretest": "npm run compile && npm run lint",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.17.6",
        "@types/vscode": "^1.90.0",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.4.1",
        "eslint": "^9.15.0",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.15.0"
    },
    "overrides": {
        "serialize-javascript": "^7.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/yuna611d/FileListUpExtension.git"
    }
}
